{
	"mcpServers": {
		"toflow": {
			"command": "npx",
			"args": [
				"mcp-remote@latest",
				"https://api.toflow.ai/mcp"
			]
		},
		"google-calendar": {
			"type": "http",
			"url": "https://gcal.mcp.claude.com/mcp"
		},
		"ai-ark": {
			"type": "http",
			"url": "https://api.ai-ark.com/v1/mcp?token=${AI_ARK_TOKEN}"
		},
		"posthog": {
			"type": "http",
			"url": "https://mcp.posthog.com/mcp",
			"headers": {
				"Authorization": "Bearer ${POSTHOG_API_KEY}"
			}
		}
	}
}